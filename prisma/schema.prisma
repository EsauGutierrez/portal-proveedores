generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                  String              @id @default(cuid())
  name                String
  isActive            Boolean             @default(true)
  netsuiteAccountId   String?
  netsuiteConsumerKey String?
  netsuiteConsumerSec String?
  netsuiteTokenId     String?
  netsuiteTokenSecret String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  invoices            Invoice[]
  paymentComplements  PaymentComplement[]
  purchaseOrders      PurchaseOrder[]
  receptions          Reception[]
  subsidiaries        Subsidiary[]
  supplierProfiles    SupplierProfile[]
  syncLogs            SyncLog[]
  users               User[]
  documentRequirements DocumentRequirement[]
}

model DocumentRequirement {
  id           String  @id @default(cuid())
  documentType String
  isRequired   Boolean @default(true)
  isOcrEnabled Boolean @default(true)
  tenantId     String
  tenant       Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, documentType])
}

model User {
  id                   String              @id @default(cuid())
  name                 String?
  email                String?             @unique
  emailVerified        DateTime?
  image                String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  password             String?
  role                 Role                @default(SUPPLIER)
  tenantId             String?
  firstLogin           Boolean             @default(true)
  passwordResetToken   String?
  passwordResetExpires DateTime?
  invoices             Invoice[]
  paymentComplements   PaymentComplement[]
  purchaseOrders       PurchaseOrder[]
  supplierProfile      SupplierProfile?
  tenant               Tenant?             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model SupplierProfile {
  id           String             @id @default(cuid())
  companyName  String
  rfc          String
  taxAddress   String
  status       SupplierStatus     @default(PENDING)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  userId       String             @unique
  subsidiaryId String
  tenantId     String
  netsuiteId        String?
  requireDocuments  Boolean            @default(false)
  documents         SupplierDocument[]
  subsidiary   Subsidiary         @relation(fields: [subsidiaryId], references: [id])
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id])

  @@unique([tenantId, rfc])
}

model SupplierDocument {
  id                String          @id @default(cuid())
  documentType      String
  fileName          String
  fileUrl           String
  status            DocumentStatus  @default(PENDING)
  rejectionReason   String?
  rejectedAt        DateTime?
  approvedAt        DateTime?
  uploadedAt        DateTime        @default(now())
  supplierProfileId String
  supplierProfile   SupplierProfile @relation(fields: [supplierProfileId], references: [id])

  @@unique([supplierProfileId, documentType])
}

model Subsidiary {
  id               String            @id @default(cuid())
  name             String
  rfc              String?
  businessName     String
  taxRegime        String
  taxAddress       String
  logoUrl          String?
  poSuiteqlQuery   String?
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  tenantId         String
  purchaseOrders   PurchaseOrder[]
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplierProfiles SupplierProfile[]
}

model PurchaseOrder {
  id           String      @id @default(cuid())
  folio        String
  fecha        DateTime
  subtotal     Decimal     @db.Decimal(10, 2)
  total        Decimal     @db.Decimal(10, 2)
  tax          Decimal     @db.Decimal(10, 2) @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  userId       String
  subsidiaryId String
  tenantId     String
  netsuiteId   String?
  subsidiary   Subsidiary  @relation(fields: [subsidiaryId], references: [id])
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User        @relation(fields: [userId], references: [id])
  recepciones  Reception[]
  invoice      Invoice?

  @@unique([tenantId, folio])
}

model Reception {
  id              String             @id @default(cuid())
  fecha           DateTime
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  purchaseOrderId String
  folio           String
  tenantId        String
  invoiceId       String?
  netsuiteId      String?
  purchaseOrder   PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id])
  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice         Invoice?           @relation(fields: [invoiceId], references: [id])
  articles        ReceptionArticle[]

  @@unique([tenantId, folio])
}

model ReceptionArticle {
  id          String    @id @default(cuid())
  quantity    Int
  unitPrice   Decimal   @db.Decimal(10, 2)
  subtotal    Decimal   @db.Decimal(10, 2)
  tax         Decimal   @db.Decimal(10, 2)
  total       Decimal   @db.Decimal(10, 2)
  receptionId String
  articleName String
  reception   Reception @relation(fields: [receptionId], references: [id], onDelete: Cascade)
}

model Invoice {
  id                 String              @id @default(cuid())
  folio              String
  fecha              DateTime
  subtotal           Decimal             @db.Decimal(10, 2)
  tax                Decimal             @db.Decimal(10, 2) @default(0)
  total              Decimal             @db.Decimal(10, 2)
  pdfUrl             String?
  xmlUrl             String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  userId             String
  purchaseOrderId    String?             @unique
  syncError          String?
  syncStatus         InvoiceSyncStatus   @default(PENDING_SYNC)
  tenantId           String
  purchaseOrder      PurchaseOrder?      @relation(fields: [purchaseOrderId], references: [id])
  receptions         Reception[]
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user               User                @relation(fields: [userId], references: [id])
  paymentComplements PaymentComplement[]

  @@unique([tenantId, folio])
}

model PaymentComplement {
  id              String                   @id @default(cuid())
  folio           String
  fecha           DateTime
  total           Decimal                  @db.Decimal(10, 2)
  pdfUrl          String?
  xmlUrl          String?
  status          PaymentComplementStatus  @default(PENDING)
  rejectionReason String?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  userId          String
  invoiceId       String
  tenantId        String
  invoice         Invoice                  @relation(fields: [invoiceId], references: [id])
  tenant          Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user            User                     @relation(fields: [userId], references: [id])

  @@unique([tenantId, folio])
}

model SyncLog {
  id           String     @id @default(cuid())
  type         SyncType
  status       SyncStatus
  createdCount Int        @default(0)
  updatedCount Int        @default(0)
  skippedCount Int        @default(0)
  totalFound   Int        @default(0)
  durationMs   Int        @default(0)
  errorMessage String?
  triggeredBy  String?
  createdAt    DateTime   @default(now())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

enum SupplierStatus {
  PENDING
  ACTIVE
  REJECTED
}

enum Role {
  SUPERADMIN
  TENANT_ADMIN
  SUPPLIER
}

enum InvoiceSyncStatus {
  PENDING_SYNC
  SYNCED
  FAILED
}

enum DocumentStatus {
  PENDING
  UPLOADED
  APPROVED
  REJECTED
}

enum SyncStatus {
  SUCCESS
  PARTIAL
  FAILED
}

enum SyncType {
  SCHEDULED
  MANUAL
}

enum PaymentComplementStatus {
  PENDING
  APPROVED
  REJECTED
}
