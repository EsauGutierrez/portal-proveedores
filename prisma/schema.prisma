// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- ENUMERACIONES ---

enum SupplierStatus {
  PENDING
  ACTIVE
  REJECTED
}

enum Role {
  SUPERADMIN
  TENANT_ADMIN
  SUPPLIER
}

enum InvoiceSyncStatus {
  PENDING_SYNC
  SYNCED
  FAILED
}

enum DocumentStatus {
  PENDING
  UPLOADED
  APPROVED
  REJECTED
}

// --- MODELOS DE LA APLICACIÓN ---

// NUEVO MODELO: Organización / Cliente
model Tenant {
  id       String  @id @default(cuid())
  name     String
  isActive Boolean @default(true)

  // Credenciales NetSuite
  netsuiteAccountId   String?
  netsuiteConsumerKey String?
  netsuiteConsumerSec String?
  netsuiteTokenId     String?
  netsuiteTokenSecret String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users              User[]
  subsidiaries       Subsidiary[]
  supplierProfiles   SupplierProfile[]
  purchaseOrders     PurchaseOrder[]
  receptions         Reception[]
  invoices           Invoice[]
  paymentComplements PaymentComplement[]
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  password      String?
  role          Role      @default(SUPPLIER)
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenantId String? // Opcional porque SUPERADMIN puede no tener tenant
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  purchaseOrders     PurchaseOrder[]
  invoices           Invoice[]
  paymentComplements PaymentComplement[]
  supplierProfile    SupplierProfile?
}

model SupplierProfile {
  id          String         @id @default(cuid())
  companyName String
  rfc         String
  taxAddress  String
  status      SupplierStatus @default(PENDING)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  subsidiaryId String
  subsidiary   Subsidiary @relation(fields: [subsidiaryId], references: [id])

  documents SupplierDocument[]

  @@unique([tenantId, rfc])
}

model SupplierDocument {
  id           String         @id @default(cuid())
  documentType String
  fileName     String
  fileUrl      String
  status       DocumentStatus @default(PENDING)
  uploadedAt   DateTime       @default(now())

  supplierProfileId String
  supplierProfile   SupplierProfile @relation(fields: [supplierProfileId], references: [id])

  @@unique([supplierProfileId, documentType])
}

model Subsidiary {
  id           String   @id @default(cuid())
  name         String
  rfc          String?
  businessName String
  taxRegime    String
  taxAddress   String
  logoUrl      String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  purchaseOrders   PurchaseOrder[]
  supplierProfiles SupplierProfile[]
}

model PurchaseOrder {
  id        String   @id @default(cuid())
  folio     String
  fecha     DateTime
  subtotal  Decimal  @db.Decimal(10, 2)
  total     Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId       String
  user         User        @relation(fields: [userId], references: [id])
  subsidiaryId String
  subsidiary   Subsidiary  @relation(fields: [subsidiaryId], references: [id])
  recepciones  Reception[]

  @@unique([tenantId, folio])
}

model Reception {
  id        String   @id @default(cuid())
  folio     String
  fecha     DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  purchaseOrderId String
  purchaseOrder   PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id])
  articles        ReceptionArticle[]
  invoice         Invoice?

  @@unique([tenantId, folio])
}

model ReceptionArticle {
  id          String  @id @default(cuid())
  articleName String
  quantity    Int
  unitPrice   Decimal @db.Decimal(10, 2)
  subtotal    Decimal @db.Decimal(10, 2)
  tax         Decimal @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)

  receptionId String
  reception   Reception @relation(fields: [receptionId], references: [id], onDelete: Cascade)
}

model Invoice {
  id         String            @id @default(cuid())
  folio      String
  fecha      DateTime
  subtotal   Decimal           @db.Decimal(10, 2)
  total      Decimal           @db.Decimal(10, 2)
  pdfUrl     String?
  xmlUrl     String?
  syncStatus InvoiceSyncStatus @default(PENDING_SYNC)
  syncError  String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId             String
  user               User                @relation(fields: [userId], references: [id])
  receptionId        String              @unique
  reception          Reception           @relation(fields: [receptionId], references: [id])
  paymentComplements PaymentComplement[]

  @@unique([tenantId, folio])
}

model PaymentComplement {
  id        String   @id @default(cuid())
  folio     String
  fecha     DateTime
  total     Decimal  @db.Decimal(10, 2)
  pdfUrl    String?
  xmlUrl    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId    String
  user      User    @relation(fields: [userId], references: [id])
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id])

  @@unique([tenantId, folio])
}
